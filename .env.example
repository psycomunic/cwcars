# ==================================================================
# Banco de dados
# ==================================================================
#
# --- Opção A: Postgres local do Prisma (desenvolvimento) ----------
# Suba com `npm run db` e cole aqui a URL que ele imprimir.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
DIRECT_URL=""
SHADOW_DATABASE_URL=""

# --- Opção B: Supabase (é o que está em uso) ----------------------
# Painel do Supabase → botão Connect → aba Direct → Type: URI.
# Pegue DUAS strings e troque [YOUR-PASSWORD] pela senha — SEM os
# colchetes, que são só marcação (mantê-los dá "password
# authentication failed").
#
# NÃO use a opção "Direct connection": ela só atende por IPv6 e não
# conecta da maioria das redes nem da Vercel.
#
# DATABASE_URL = APP, Transaction pooler (Supavisor, porta 6543).
# DATABASE_URL="postgresql://postgres.<REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require"
#
# DIRECT_URL = MIGRATIONS, Session pooler (porta 5432), porque o
#   pooler em modo transação não executa DDL.
# DIRECT_URL="postgresql://postgres.<REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require"
#
# uselibpqcompat=true&sslmode=require: obrigatório. Sozinho, o
#   sslmode=require é tratado pelo pg >= 8.23 como verify-full, e o
#   certificado do Supabase vem de uma CA própria — sem o par, a
#   conexão falha com "self-signed certificate in certificate chain".
#
# Senha com caractere especial (@ : / ? # &) precisa ir percent-encoded.
#
# SHADOW_DATABASE_URL pode ficar vazio no Supabase.

# Conexões simultâneas do app. Em branco usa 1 em desenvolvimento
# (o Postgres local não aguenta mais) e 10 em produção.
# Com o pooler do Supabase em modo transação, use algo entre 1 e 5.
DATABASE_POOL_MAX=""

# ==================================================================
# Supabase Storage (fotos dos veículos)
# ==================================================================
# Sem estas variáveis, os uploads do painel vão para public/uploads —
# o que NÃO funciona em hospedagem com disco efêmero (Vercel).
# As chaves estão em: Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://bwwapwvuadxjkcjfffcj.supabase.co"
# service_role: chave secreta, NUNCA exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=""
# Nome do bucket público criado no Storage.
SUPABASE_STORAGE_BUCKET="veiculos"

# ==================================================================
# Aplicação
# ==================================================================
# Chave de assinatura da sessão do admin — 32+ caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# URL pública do site (metadata, sitemap, links de e-mail)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
